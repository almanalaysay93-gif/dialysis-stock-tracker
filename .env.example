# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string: Dashboard → Connect.
# On your machine (dev, migrations, user:set): "Direct connection" or
# "Session pooler" (port 5432).
# In Vercel's environment variables: "Transaction pooler" (port 6543).
# Replace the password placeholder with the database password.
DATABASE_URL=

# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port the server listens on (optional, default 3000).
PORT=3000
