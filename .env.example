# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string: Dashboard → Connect.
# Use "Direct connection" or "Session pooler" (port 5432). Both work for the
# app and for migrations. Replace the password placeholder with the database password.
DATABASE_URL=

# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port the server listens on (optional, default 3000).
PORT=3000
