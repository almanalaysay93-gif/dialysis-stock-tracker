# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string: Dashboard → Connect.
# On your machine (dev, migrations): "Direct connection" or
# "Session pooler" (port 5432).
# In Vercel's environment variables: "Transaction pooler" (port 6543). The direct
# connection is IPv6-only and Vercel cannot reach it.
# Replace the password placeholder with the database password.
DATABASE_URL=

# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google sign-in. Without the first two, nobody can sign in.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs: https://<your-domain>/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for local use).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google addresses allowed to sign in. They become admins.
ADMIN_EMAILS=share@spmcdvo.net

# Port the server listens on (optional, default 3000).
PORT=3000
